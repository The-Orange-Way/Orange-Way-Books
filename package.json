{
  "name": "orangewaybooks",
  "description": "Open-source, zero-knowledge accounting where the server cannot read your books. Bitcoin-native. Apache-2.0.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
