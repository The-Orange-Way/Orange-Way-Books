#
# Orange Way Books — sample environment file.
#
# Copy to `.env` (which is gitignored) and fill in the values for your local
# Supabase project. Production deployments should set these via the hosting
# platform's secret / env-var UI and never commit real values.
#
# The three VITE_ values below are required for the browser build. They are
# embedded into the client bundle at build time — only commit values that
# are intentionally public (the Supabase "publishable" / anon key is
# designed to be public, see Supabase docs).
#

VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# OrangeRails integration is server-side only — the Edge Function secret
# `OR_SUPABASE_URL` (set in Supabase Dashboard → Edge Functions → Secrets,
# no VITE_ prefix) is what the or-proxy function reads. The client never
# talks to OrangeRails directly.

# Flash OAuth (optional; required for the Connections page Flash flow).
# Get these values from your Flash platform admin dashboard.
VITE_FLASH_CLIENT_ID=""
VITE_FLASH_AUTHORIZATION_URL=""

# hCaptcha — browser-safe site key (the matching SECRET goes in the
# Supabase Dashboard → Auth → Bot/Abuse Protection, never here). If
# this is unset, the signup form skips the captcha challenge — only
# acceptable for local dev.
VITE_HCAPTCHA_SITE_KEY=""

# PostHog (optional): anonymous SaaS analytics. When this key is unset
# the SDK never initializes and no events are sent. Self-host builds
# disable PostHog regardless of these values (see src/main.tsx). Read
# the privacy notice in the app shell before turning this on.
VITE_POSTHOG_KEY=""
# Defaults to https://eu.i.posthog.com when unset; override for a
# self-hosted PostHog or a different region.
VITE_POSTHOG_HOST=""

# Orange Rails Bitcoin Index (ORBI): read-only public Supabase project
# providing live BTC/fiat exchange rates. Optional: if unset, the app
# falls back to a static rate cached in code and logs a warning.
# Both values are intentionally public (RLS-gated, anon-key only).
VITE_ORBI_SUPABASE_URL=""
VITE_ORBI_SUPABASE_ANON_KEY=""

#
# Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets,
# NOT here). Listed for discoverability only.
#
#   SUPABASE_SERVICE_ROLE_KEY  — auto-provided by Supabase.
#   LEDGER_GRAPHQL_URL           — reverse-proxy URL of your legacy-ledger instance.
#   LEDGER_API_KEY             : shared secret forwarded as the legacy-ledger API key header.
#   OXR_APP_ID                 — Open Exchange Rates app id (fiat pairs).
#   ALLOWED_ORIGINS            : REQUIRED. Comma-separated allow-list for
#                                Edge Function CORS. If unset, cross-origin
#                                callers fail CORS (no fallback origin).
#   INVITE_REDIRECT_URL        — magic-link landing URL for org invites.
#   OR_SUPABASE_URL            — server-side counterpart of VITE_OR_SUPABASE_URL.
#   OR_PLATFORM_API_KEY        — platform key for the or-proxy edge function.
#
