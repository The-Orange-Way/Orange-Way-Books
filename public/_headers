# Cloudflare Pages edge headers — apply to every response (Cloudflare Pages
# matches "/*" against every request, HTML included).
#
# M13 (2026-05-19 audit) shipped this header plus a duplicate <meta
# http-equiv="Content-Security-Policy"> in index.html. Parity work (Row 11,
# 2026-06-30) removed the <meta> tag: a <meta> CSP can't carry report-uri or
# frame-ancestors, and keeping both meant the browser enforced the
# intersection of two policies, which is easy to get wrong. This header is
# now the sole CSP delivery mechanism, for HTML and non-HTML responses alike.
#
# Per-directive rationale (carried over from the deleted <meta> tag comment
# so it isn't lost; without this, a future contributor could "clean up" an
# origin that's actually load-bearing):
#   script-src:  'wasm-unsafe-eval' is required by hash-wasm for Argon2id in
#                the vault unlock + Orange Rails sync flows, not a leftover.
#                'unsafe-inline' is staged out below (Report-Only policy).
#   style-src:   'unsafe-inline' is required, Tailwind emits inline <style>
#                tags. fonts.googleapis.com is Google Fonts' stylesheet host.
#   connect-src: Supabase REST/Auth/Edge + WebSocket. PostHog EU endpoints
#                for product analytics. No direct CoinGecko/OXR entry needed,
#                those go through edge functions.
#   img-src:     'self' + blob/data for CSV/print workflows.
#   object-src 'none' + base-uri 'self' close classic injection vectors.

/*
  # Force HTTPS for two years on this host + all subdomains, with preload.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Enforced CSP. Kept at parity with the sibling Orange Way app's shipped policy: 'unsafe-inline'
  # stays in script-src for now (matches the previous meta tag) while the
  # Report-Only header below is verified in production with zero
  # violations; then this drops 'unsafe-inline' too and the Report-Only
  # header retires. See the strict Report-Only policy below for the target
  # end state and the sha256 hash of the one inline script we ship
  # (Chatwoot's bootstrap loader in index.html).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://eu-assets.i.posthog.com https://challenges.cloudflare.com https://support.orangeway.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://challenges.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://eu.i.posthog.com https://support.orangeway.app; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://challenges.cloudflare.com https://support.orangeway.app wss://support.orangeway.app https://pulse.orangeway.app; frame-src https://challenges.cloudflare.com https://support.orangeway.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

  # Report-Only strict policy (Row 11 parity, 2026-06-30): drops
  # 'unsafe-inline' from script-src in favor of the sha256 hash of the
  # Chatwoot bootstrap script (the only inline <script> we ship). Logs
  # violations to the browser console without breaking anything. Once this
  # runs clean in production for a few days, flip the enforced header above
  # to match and delete this one. report-uri is a fast-follow (needs Books'
  # own GlitchTip/Sentry key wired the same way the sibling Orange Way app's is).
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-S3sWvvaDxIfv9kEKXT1CsZAuKK0tc/sb4G/WXCrp6LA=' 'wasm-unsafe-eval' https://eu-assets.i.posthog.com https://challenges.cloudflare.com https://support.orangeway.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://challenges.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://eu.i.posthog.com https://support.orangeway.app; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://challenges.cloudflare.com https://support.orangeway.app wss://support.orangeway.app https://pulse.orangeway.app; frame-src https://challenges.cloudflare.com https://support.orangeway.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

  # Defense in depth — older browsers + non-CSP-aware clients.
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

  # Block geolocation / camera / microphone / payment unless explicitly used.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
